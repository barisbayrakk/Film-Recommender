# ==============================================================================
# Environment Variables Example for Film-Recommender Backend
# Copy this file to .env and configure the values appropriately.
# ==============================================================================

# TMDB API Settings
TMDB_API_KEY=your_tmdb_v3_api_key_here
TMDB_V4_TOKEN=your_tmdb_v4_bearer_token_here

# JWT Authentication Settings
# Generate a secure key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Verification Settings (e.g. Mailtrap or custom SMTP)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password
MAIL_FROM=no-reply@filmrecommender.com

# Frontend and CORS URLs
FRONTEND_URL=http://localhost:3000

# Database URL (Default SQLite, or PostgreSQL: postgresql://user:pass@host/dbname)
DATABASE_URL=sqlite:///./app/movies.db

# Google reCAPTCHA v2 Secret Key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
