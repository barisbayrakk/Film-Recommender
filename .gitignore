# ==============================================================================
# Git Ignore - Film Recommender Project
# ==============================================================================

# --------------------------------------------------
# Secrets & Environment Files
# --------------------------------------------------
.env
.env.*
*.env
!*.env.example
*.save
*.bak

# --------------------------------------------------
# Python & Virtual Environments
# --------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
pyvenv.cfg

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
htmlcov/

# --------------------------------------------------
# Machine Learning & Large Artifacts
# --------------------------------------------------
*.pkl
*.pickle
*.h5
*.pt
*.pth
*.onnx

# --------------------------------------------------
# Databases & Local Data
# --------------------------------------------------
*.db
*.sqlite
*.sqlite3
app/movies.db

# --------------------------------------------------
# Node & Frontend (React)
# --------------------------------------------------
node_modules/
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env
frontend/.env.*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------------------------------
# Operating System & IDE Files
# --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vscode/
.idea/
*.swp
*.swo
*~

# Backups
.gitignore_backup
